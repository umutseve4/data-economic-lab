# Copy this file to .env and fill in your own values.
# .env is gitignored. Never commit real credentials.

# --- Credentials -------------------------------------------------------------
# Free key from https://evds2.tcmb.gov.tr (Profile -> API Key).
# Required ONLY for `--source evds`. Not needed for `--source sample`.
EVDS_API_KEY=your_evds_api_key_here

# --- Paths (defaults shown) --------------------------------------------------
ECOLAB_DATA_DIR=data
ECOLAB_DB_PATH=data/economic.db
ECOLAB_REPORT_DIR=reports

# --- Run parameters (defaults shown) -----------------------------------------
ECOLAB_START=2019-01-01
ECOLAB_END=2024-12-01
ECOLAB_SOURCE=sample
ECOLAB_LOG_LEVEL=INFO

# --- Network behaviour (defaults shown) --------------------------------------
ECOLAB_HTTP_TIMEOUT=30
ECOLAB_MAX_RETRIES=3
ECOLAB_BACKOFF_BASE=1.0

# --- EVDS series codes (defaults shown) --------------------------------------
ECOLAB_SERIES_CPI=TP.FG.J0
ECOLAB_SERIES_USDTRY=TP.DK.USD.A.YTL
ECOLAB_SERIES_POLICY_RATE=TP.APIFON4
